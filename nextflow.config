manifest {
    name = 'container-family-recoverable-builds'
    version = '1.0.0'
    nextflowVersion = '26.04.6'
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    cache = 'deep'
    errorStrategy = 'finish'
    maxRetries = 0

    withLabel: repository_stage {
        maxForks = 2
    }
}

trace {
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,realtime,attempt,submit,start,complete,duration,error_action,workdir'
}

report {
    overwrite = true
}

timeline {
    overwrite = true
}

dag {
    overwrite = true
}
