manifest {
    name = 'container-family-recoverable-builds'
    version = '1.0.0'
    nextflowVersion = '26.04.6'
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    cache = 'deep'
    errorStrategy = 'terminate'
    maxRetries = 0

    withLabel: repository_stage {
        maxForks = 2
    }

    // Two simultaneous Swift package graphs contended for the same host
    // resources in the 0.14 release. Keep Swift work serial while allowing one
    // independent Go/Homebrew stage beside it.
    withName: RUN_SWIFT_STAGE {
        maxForks = 1
    }

    withName: RUN_LIGHTWEIGHT_STAGE {
        maxForks = 1
    }

    withName: RUN_DOCUMENTATION_STAGE {
        maxForks = 1
    }
}

trace {
    overwrite = true
    fields = 'task_id,hash,native_id,name,status,exit,realtime,attempt,submit,start,complete,duration,error_action,workdir'
}

report {
    overwrite = true
}

timeline {
    overwrite = true
}

dag {
    overwrite = true
}
