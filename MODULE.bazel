    enhanced = "//:Package.resolved",
    stock = "//:Package.stock.resolved",
)
use_repo(
    swift_deps,
    "swiftpkg_container",
    "swiftpkg_containerization",
    "swiftpkg_container_engine_api",
    "swiftpkg_swift_argument_parser",
    "swiftpkg_swift_collections",
    "swiftpkg_swift_docc_plugin",
    "swiftpkg_swift_log",
    "swiftpkg_swift_nio",
)

# Preserve root and nested Sources notices supplied by the selected Swift packages.
single_version_override(
    module_name = "rules_swift_package_manager",
    version = "1.23.0",
    patches = ["//Tools/bazel:licenses/rules-swift-all-notices.patch"],
    patch_strip = 1,
)

# Expose SDK notices and isolate Clang sanitizers from Go's own runtime modes.
single_version_override(
    module_name = "rules_go",
    version = "0.60.0",
    patches = [
        "//Tools/bazel:licenses/rules-go-sdk-notices.patch",
        "//Tools/bazel:rules-go-sanitizer-isolation.patch",
    ],
    patch_strip = 1,
)

# macOS Foundation createFile can use a volume-level replacement directory,
# which is outside Bazel's sandbox when outputs live on the external SSD.
single_version_override(
    module_name = "rules_swift",
    version = "3.6.1",
    patches = ["//Tools/bazel:rules-swift-sandbox-output.patch"],
    patch_strip = 1,
)
