module(name = "container_compose")

bazel_dep(name = "rules_swift", version = "3.6.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "apple_support", version = "1.24.2")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_swift_package_manager", version = "1.23.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_apple", version = "4.3.3", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.50.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//Tools/compose-normalizer:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//Tools/compose-normalizer:go.mod")
use_repo(
    go_deps,
    "com_github_defanglabs_secret_detector",
    "com_github_compose_spec_compose_go_v2",
    "com_github_containerd_containerd_v2",
    "com_github_containerd_errdefs",
    "com_github_distribution_reference",
    "com_github_docker_cli",
    "com_github_moby_buildkit",
    "com_github_opencontainers_go_digest",
    "com_github_opencontainers_image_spec",
    "com_github_sirupsen_logrus",
    "in_yaml_go_yaml_v4",
    "org_golang_x_sys",
)

swift_deps = use_extension("//Tools/bazel:dependencies.bzl", "dependencies")
swift_deps.lockfiles(
    enhanced = "//:Package.resolved",
    stock = "//:Package.stock.resolved",
)
use_repo(
    swift_deps,
    "swiftpkg_container",
    "swiftpkg_containerization",
    "swiftpkg_container_engine_api",
    "swiftpkg_swift_argument_parser",
    "swiftpkg_swift_collections",
    "swiftpkg_swift_docc_plugin",
    "swiftpkg_swift_log",
    "swiftpkg_swift_nio",
)

# macOS Foundation createFile can use a volume-level replacement directory,
# which is outside Bazel's sandbox when outputs live on the external SSD.
single_version_override(
    module_name = "rules_swift",
    version = "3.6.1",
    patches = ["//Tools/bazel:rules-swift-sandbox-output.patch"],
    patch_strip = 1,
)
