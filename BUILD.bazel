load("@build_bazel_rules_swift//swift:swift_binary.bzl", "swift_binary")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("@build_bazel_rules_swift//swift:swift_test.bzl", "swift_test")
load("//Tools/bazel:fixture_bundle.bzl", "fixture_bundle")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "stock_runtime",
    define_values = {"runtime_profile": "stock"},
)

SWIFT_COPTS = ["-swift-version", "6", "-warnings-as-errors", "-package-name", "container_compose"]
RUNTIME_COPTS = SWIFT_COPTS + select({
    ":stock_runtime": [],
    "//conditions:default": ["-DCONTAINER_COMPOSE_ENHANCED_RUNTIME"],
})

swift_library(
    name = "ComposeRuntimeSPI",
    srcs = glob(["Sources/ComposeRuntimeSPI/*.swift"]),
    module_name = "ComposeRuntimeSPI",
    copts = SWIFT_COPTS,
)

swift_library(
    name = "ComposeCore",
    srcs = glob(["Sources/ComposeCore/*.swift"]),
    module_name = "ComposeCore",
    copts = SWIFT_COPTS,
    deps = [":ComposeRuntimeSPI"],
)

swift_library(
    name = "ComposeEngineRuntime",
    srcs = glob(["Sources/ComposeEngineRuntime/*.swift"]),
    module_name = "ComposeEngineRuntime",
    copts = SWIFT_COPTS,
    deps = [
        ":ComposeCore",
        ":ComposeRuntimeSPI",
        "@swiftpkg_container_engine_api//:ContainerEngineWire",
        "@swiftpkg_container_engine_api//:ContainerUnixHTTPClient",
    ],
    target_compatible_with = select({":stock_runtime": [], "//conditions:default": ["@platforms//:incompatible"]}),
)

swift_library(
    name = "ComposeContainerRuntime",
    srcs = glob(["Sources/ComposeContainerRuntime/*.swift"]),
    module_name = "ComposeContainerRuntime",
    copts = RUNTIME_COPTS,
    deps = [
        ":ComposeCore",
        ":ComposeRuntimeSPI",
        "@swiftpkg_swift_argument_parser//:ArgumentParser",
        "@swiftpkg_container//:ContainerAPIClient",
        "@swiftpkg_container//:ContainerCommands",
        "@swiftpkg_container//:ContainerPersistence",
        "@swiftpkg_container//:ContainerResource",
        "@swiftpkg_containerization//:Containerization",
        "@swiftpkg_containerization//:ContainerizationArchive",
        "@swiftpkg_containerization//:ContainerizationEXT4",
        "@swiftpkg_containerization//:ContainerizationExtras",
        "@swiftpkg_containerization//:ContainerizationOCI",
        "@swiftpkg_swift_log//:Logging",
    ],
    target_compatible_with = select({":stock_runtime": ["@platforms//:incompatible"], "//conditions:default": []}),
)

# The executable and CLI tests must share the same compiled entry-point module.
swift_library(
    name = "ComposePlugin",
    srcs = glob(["Sources/ComposePlugin/*.swift"]),
    module_name = "ComposePlugin",
    copts = RUNTIME_COPTS + ["-parse-as-library", "-Xfrontend", "-entry-point-function-name", "-Xfrontend", "ComposePlugin_main"],
    deps = [
        ":ComposeCore",
        "@swiftpkg_swift_argument_parser//:ArgumentParser",
        "@swiftpkg_container//:ContainerAPIClient",
        "@swiftpkg_container//:ContainerBuild",
        "@swiftpkg_container//:ContainerCommands",
        "@swiftpkg_container//:ContainerLog",
        "@swiftpkg_container//:ContainerResource",
    ] + select({":stock_runtime": [":ComposeEngineRuntime"], "//conditions:default": [":ComposeContainerRuntime"]}),
)

swift_binary(
    name = "compose",
    linkopts = ["-Wl,-alias,_ComposePlugin_main,_main", "-Wl,-u,_ComposePlugin_main"],
    deps = [":ComposePlugin"],
)

filegroup(
    name = "product",
    srcs = [
        ":compose",
        "//Tools/compose-normalizer:compose-normalizer",
        "//Tools/compose-normalizer/cmd/volume-initializer:compose-volume-initializer-linux-arm64",
        "//Tools/compose-normalizer/cmd/volume-initializer:compose-volume-initializer-linux-amd64",
    ],
)

swift_test(
    name = "ComposeRuntimeSPITests",
    srcs = glob(["Tests/ComposeRuntimeSPITests/*.swift"]),
    copts = SWIFT_COPTS,
    deps = [":ComposeRuntimeSPI", ":ComposeTestStorage"],
)

swift_library(
    name = "ComposeTestStorage",
    testonly = True,
    srcs = ["Tests/ComposeTestStorage/TestStorage.swift"],
    module_name = "ComposeTestStorage",
    copts = SWIFT_COPTS,
)

swift_test(
    name = "ComposePluginTests",
    srcs = glob(["Tests/ComposePluginTests/*.swift"]),
    copts = RUNTIME_COPTS,
    data = [":compose", "docs/project/STATUS.md"],
    env = {"COMPOSE_TEST_EXECUTABLE": "$(rootpath :compose)"},
    deps = [":ComposeCore", ":ComposePlugin", ":ComposeTestStorage"],
)

swift_test(
    name = "ComposeEngineRuntimeTests",
    srcs = glob(["Tests/ComposeEngineRuntimeTests/*.swift"]),
    copts = SWIFT_COPTS,
    deps = [
        ":ComposeEngineRuntime", ":ComposeRuntimeSPI", ":ComposeTestStorage",
        "@swiftpkg_container_engine_api//:ContainerEngineWire",
        "@swiftpkg_container_engine_api//:ContainerUnixHTTPServer",
        "@swiftpkg_swift_log//:Logging",
    ],
    target_compatible_with = select({":stock_runtime": [], "//conditions:default": ["@platforms//:incompatible"]}),
)

fixture_bundle(
    name = "ComposeCoreFixtures",
    testonly = True,
    srcs = glob(["Tests/ComposeCoreTests/Fixtures/**/*"]),
)

filegroup(name = "ComposeCoreFixtureAccessor", testonly = True, srcs = [":ComposeCoreFixtures"], output_group = "accessor")
filegroup(name = "ComposeCoreFixtureBundle", testonly = True, srcs = [":ComposeCoreFixtures"], output_group = "bundle")

swift_test(
    name = "ComposeCoreTests",
    srcs = glob(["Tests/ComposeCoreTests/*.swift"], exclude = ["Tests/ComposeCoreTests/ComposeTemporaryFilesTests.swift"]) + [":ComposeCoreFixtureAccessor"],
    copts = SWIFT_COPTS,
    data = [
        ":ComposeCoreFixtureBundle",
        "Tests/ComposeCoreTests/Fixtures/logging/docker-engine-29.2.1-terminal-session.json",
        "Package.swift",
        "examples/logging/compose.yml",
        "//Tools/compose-normalizer:go.mod",
        "//Tools/compose-normalizer:compose-normalizer",
    ],
    env = {"COMPOSE_NORMALIZER_RUNFILE": "$(rootpath //Tools/compose-normalizer:compose-normalizer)"},
    deps = [
        ":ComposeCore", ":ComposeContainerRuntime", ":ComposeTestStorage",
        "@swiftpkg_container//:ContainerResource",
        "@swiftpkg_containerization//:ContainerizationArchive",
        "@swiftpkg_containerization//:ContainerizationExtras",
    ],
    target_compatible_with = select({":stock_runtime": ["@platforms//:incompatible"], "//conditions:default": []}),
    timeout = "long",
)

swift_test(
    name = "ComposeContainerRuntimeTests",
    srcs = glob(["Tests/ComposeContainerRuntimeTests/*.swift"]),
    copts = SWIFT_COPTS,
    deps = [
        ":ComposeContainerRuntime", ":ComposeRuntimeSPI", ":ComposeTestStorage",
        "@swiftpkg_container//:ContainerResource",
        "@swiftpkg_containerization//:ContainerizationEXT4",
        "@swiftpkg_containerization//:ContainerizationOCI",
    ],
    target_compatible_with = select({":stock_runtime": ["@platforms//:incompatible"], "//conditions:default": []}),
)

test_suite(
    name = "unit_stock",
    tests = [":ComposeRuntimeSPITests", ":ComposePluginTests", ":ComposeEngineRuntimeTests", ":ComposeTemporaryFilesTests", ":unit_go"],
)

test_suite(
    name = "unit_enhanced",
    tests = [":ComposeRuntimeSPITests", ":ComposePluginTests", ":ComposeCoreTests", ":ComposeContainerRuntimeTests", ":ComposeTemporaryFilesTests", ":unit_go"],
)

test_suite(
    name = "unit_go",
    tests = [
        "//Tools/compose-normalizer:compose-normalizer_test",
        "//Tools/compose-normalizer/oci:oci_test",
        "//Tools/compose-normalizer/remote:remote_test",
        "//Tools/compose-normalizer/transform:transform_test",
        "//Tools/compose-normalizer/cmd/volume-initializer:volume-initializer_test",
        "//Tools/compose-normalizer/cmd/volume-initializer:permission_bits_test",
    ],
)

swift_test(
    name = "ComposeTemporaryFilesTests",
    srcs = ["Tests/ComposeCoreTests/ComposeTemporaryFilesTests.swift"],
    copts = SWIFT_COPTS,
    deps = [":ComposeCore", ":ComposeTestStorage"],
)
