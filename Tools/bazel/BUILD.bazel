load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["rules-swift-sandbox-output.patch", "package.py"])

sh_binary(
    name = "ssd_test_runner",
    srcs = ["ssd-test-runner.sh"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "cli_smoke",
    srcs = ["tests/cli-smoke.sh"],
    args = ["$(location //:compose)"],
    data = ["//:compose"],
    size = "small",
)

sh_test(
    name = "package_tests",
    srcs = ["tests/package.sh"],
    args = ["$(location test_package.py)", "$(location //:Tools/release/write-build-info.py)", "unit"],
    data = ["package.py", "test_package.py", "//:Tools/release/write-build-info.py"],
    size = "small",
)

sh_test(
    name = "package_smoke",
    srcs = ["tests/package.sh"],
    args = ["$(location test_package.py)", "$(location //:Tools/release/write-build-info.py)", "archive", "$(location //:candidate_archive_payload)"],
    data = ["package.py", "test_package.py", "//:Tools/release/write-build-info.py", "//:candidate_archive_payload"],
    size = "small",
)

sh_test(
    name = "release_notes_tests",
    srcs = ["tests/release-notes.sh"],
    args = ["$(location //:Tools/release/test_release_notes.py)"],
    data = ["//:Tools/release/test_release_notes.py", "//:Tools/release/release-notes.py"],
    size = "small",
)
