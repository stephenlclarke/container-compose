load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "remote",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/stephenlclarke/container-compose/Tools/compose-normalizer/remote",
    deps = [
        "//Tools/compose-normalizer/oci:oci",
        "@com_github_compose_spec_compose_go_v2//cli:go_default_library",
        "@com_github_compose_spec_compose_go_v2//loader:go_default_library",
        "@com_github_compose_spec_compose_go_v2//types:go_default_library",
        "@com_github_containerd_containerd_v2//core/images:go_default_library",
        "@com_github_containerd_containerd_v2//core/remotes:go_default_library",
        "@com_github_distribution_reference//:go_default_library",
        "@com_github_docker_cli//cli/config:go_default_library",
        "@com_github_moby_buildkit//frontend/dockerfile/dfgitutil:go_default_library",
        "@com_github_opencontainers_image_spec//specs-go/v1:go_default_library",
        "@com_github_sirupsen_logrus//:go_default_library",
        "@org_golang_x_sys//windows:go_default_library"
    ],
)

go_test(
    name = "remote_test",
    args = ["-test.v"],
    srcs = glob(["*_test.go"]),
    embed = [":remote"],
    deps = [
        "//Tools/compose-normalizer/oci:oci",
        "@com_github_containerd_containerd_v2//core/remotes:go_default_library",
        "@com_github_distribution_reference//:go_default_library",
        "@com_github_moby_buildkit//frontend/dockerfile/dfgitutil:go_default_library",
        "@com_github_opencontainers_go_digest//:go_default_library",
        "@com_github_opencontainers_image_spec//specs-go/v1:go_default_library",
        "@com_github_sirupsen_logrus//:go_default_library"
    ],
)
