load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "transform",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/stephenlclarke/container-compose/Tools/compose-normalizer/transform",
    deps = [
        "@in_yaml_go_yaml_v4//:go_default_library"
    ],
)

go_test(
    name = "transform_test",
    # rules_go owns coverage here; there are no first-party C sources.
    env = {"CC_CODE_COVERAGE_SCRIPT": ""},
    args = ["-test.v"],
    srcs = glob(["*_test.go"]),
    embed = [":transform"],
    deps = [],
)
